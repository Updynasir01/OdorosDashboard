{
  "name": "somalia-drought-dashboard-backend",
  "version": "1.0.0",
  "description": "Backend API for Somalia Drought Monitoring Dashboard",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20 <25"
  },
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "seed": "ts-node-dev --transpile-only src/scripts/seedDatabase.ts",
    "switch-to-real": "ts-node-dev --transpile-only src/scripts/switchToRealData.ts"
  },
  "dependencies": {
    "express": "^4.18.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "mongoose": "^8.0.3",
    "axios": "^1.6.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^1.4.5-lts.1",
    "@types/express": "^4.17.21",
    "@types/cors": "^2.8.17",
    "@types/node": "^20.10.5",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/multer": "^1.4.12"
  },
  "devDependencies": {
    "typescript": "5.9.3",
    "ts-node-dev": "^2.0.0"
  }
}
